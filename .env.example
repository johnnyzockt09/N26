# ============================================================
# N26 Minecraft Banking - Environment Example (Variante C Standard)
# ============================================================
# THIS FILE CONTAINS NO REAL SECRETS.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
# Variante C (empfohlen): Webseite + API + SQLite + RCON laufen auf dem
# Server (CasaOS/Docker), EINE URL, keine Netlify-Env noetig.
# Variante A: Backend auf dem Pi; Variante B: Backend als Netlify-Function.

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------
# Datenbank - SQLite (Standard, keine Einrichtung)
# ------------------------------------------------------------
DATABASE_URL=sqlite:./data/n26.db
# Postgres (Variante A/B):
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ------------------------------------------------------------
# Session / Auth
# ------------------------------------------------------------
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Das Install-Skript (scripts/deploy-server.sh) setzt das automatisch.
SESSION_SECRET=please_change_this_to_a_long_random_string

# CORS - exakt die Frontend-Origin; in Variante C egal (same-origin):
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# RCON - erreichbar unter der Server-IP (NICHT 127.0.0.1 bei euch)
# ------------------------------------------------------------
RCON_HOST=209.25.141.16
RCON_PORT=43323
RCON_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# Minecraft
# ------------------------------------------------------------
MINECRAFT_SERVER_ADDRESS=
MINECRAFT_SERVER_PORT=25565
PLAYIT_PUBLIC_ADDRESS=

# ------------------------------------------------------------
# Admin-Rolle (MC-Name -> Web-Admin nach Verknuepfung)
# ------------------------------------------------------------
ADMIN_MC_USERNAMES=Johnnyzockt09

# ------------------------------------------------------------
# Security tuning (optional)
# ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_API=60
VERIFICATION_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800

# ------------------------------------------------------------
# Netlify-Varianten (nur falls genutzt):
#  B (Function): gleiche Werte in der Netlify-UI setzen - Netlify liest
#    KEINE .env. VITE_API_URL dabei NICHT setzen.
#  A (Pi-Backend): VITE_API_URL=https://api.<domain> als Frontend-Build-Env.
# ------------------------------------------------------------